import xarray as xr
import numpy as np
import matplotlib.pyplot as plt
import cartopy.crs as ccrs
import cartopy.feature as cfeature
# =============================
# 1. Settings
# =============================
year = 2000
sst_folder = r"C:/Users/Aina Ajibola/Desktop/oisst_data"
p90_file = r"C:/Users/Aina Ajibola/Desktop/P90_1981-2010/threshold.nc"
# =============================
# 2. Load SST and P90
# =============================
print("Loading SST files...")
sst_ds = xr.open_mfdataset(
    f"{sst_folder}/{year}*.nc",
    combine="by_coords"
)
p90_ds = xr.open_dataset(p90_file)
print("Files loaded.")
# =============================
# 3. Extract variables and remove zlev
# =============================
sst = sst_ds["sst"].isel(zlev=0, drop=True)
p90 = p90_ds["p90_threshold"].isel(zlev=0, drop=True)
# =============================
# 4. Match SST region to P90 grid
# =============================
sst = sst.sel(
    lat=slice(0, 30),
    lon=slice(300, 350)
)
sst = sst.sel(
    lat=p90.lat,
    lon=p90.lon
)
sst = sst.transpose("time", "lat", "lon")
p90 = p90.transpose("dayofyear", "lat", "lon")
print("SST shape:", sst.shape)
print("P90 shape:", p90.shape)
# =============================
# 5. Match daily P90 to SST dates
# =============================
sst = sst.assign_coords(
    dayofyear=sst["time"].dt.dayofyear
)
p90_for_year = p90.sel(
    dayofyear=sst["dayofyear"]
)
p90_for_year = p90_for_year.assign_coords(
    time=sst["time"]
)
p90_for_year = p90_for_year.transpose("time", "lat", "lon")
# Load arrays into memory for one year
sst = sst.compute()
p90_for_year = p90_for_year.compute()
# =============================
# 6. Detect daily exceedance
# =============================
above_p90 = sst > p90_for_year
# =============================
# 7. Detect valid MHW days >= 5 consecutive days
# =============================
def detect_mhw_1d(arr):
    arr = np.asarray(arr)
    arr = np.nan_to_num(arr, nan=False).astype(bool)
    result = np.zeros_like(arr, dtype=bool)
    n = len(arr)
    i = 0
    while i < n:
        if arr[i]:
            start = i
            while i < n and arr[i]:
                i += 1
            end = i
            duration = end - start
            if duration >= 5:
                result[start:end] = True
        else:
            i += 1
    return result

print("Detecting MHW days...")
mhw_days = xr.apply_ufunc(
    detect_mhw_1d,
    above_p90,
    input_core_dims=[["time"]],
    output_core_dims=[["time"]],
    vectorize=True,
    output_dtypes=[bool]
)
mhw_days = mhw_days.transpose("time", "lat", "lon")
print("MHW days detected.")
# =============================
# 8. Calculate daily intensity
# =============================
daily_intensity = sst - p90_for_year
# Keep intensity only during valid MHW days
mhw_intensity = daily_intensity.where(mhw_days)
# =============================
# 9. Maximum MHW intensity per grid cell
# =============================
max_mhw_intensity = mhw_intensity.max(dim="time", skipna=True)
print("=================================")
print(f"Maximum MHW Intensity Summary: {year}")
print("=================================")
print(f"Maximum intensity over domain: {float(max_mhw_intensity.max(skipna=True)):.2f} °C")
print(f"Mean maximum intensity over domain: {float(max_mhw_intensity.mean(skipna=True)):.2f} °C")
# =============================
# 10. Plot maximum MHW intensity map
# =============================
fig = plt.figure(figsize=(10, 6))
ax = plt.axes(projection=ccrs.PlateCarree())
pcm = max_mhw_intensity.plot(
    ax=ax,
    transform=ccrs.PlateCarree(),
    cmap="hot_r",
    add_colorbar=False,
    vmin=0,
    vmax=float(max_mhw_intensity.max(skipna=True))
)
ax.coastlines()
ax.add_feature(cfeature.LAND, facecolor="lightgray")
gl = ax.gridlines(draw_labels=True)
gl.top_labels = False
gl.right_labels = False
cbar = plt.colorbar(
    pcm,
    ax=ax,
    orientation="horizontal",
    pad=0.08,
    fraction=0.05
)
cbar.set_label("Maximum MHW Intensity (°C above P90)")
plt.title(
    f"Maximum Marine Heatwave Intensity Based on Daily SST − Daily P90 ({year})"
)
plt.tight_layout()
plt.show()
