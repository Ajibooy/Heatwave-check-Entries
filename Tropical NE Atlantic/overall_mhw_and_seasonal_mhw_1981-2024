import pandas as pd
import matplotlib.pyplot as plt
import cartopy.crs as ccrs
import cartopy.feature as cfeature
# =============================
# 1. Load CSV
# =============================
csv_file = r"C:/Users/Aina Ajibola/Desktop/mhw_events_1981_2024.csv"
df = pd.read_csv(csv_file)
# =============================
# 2. Convert longitude from 0–360 to -180–180
# =============================
df["lon_plot"] = df["lon"].where(
    df["lon"] <= 180,
    df["lon"] - 360
)
# =============================
# 3. Overall MHW frequency grid
# =============================
overall_freq = (
    df
    .groupby(["lat", "lon_plot"])
    .size()
    .reset_index(name="frequency")
)
overall_grid = overall_freq.pivot(
    index="lat",
    columns="lon_plot",
    values="frequency"
)
# =============================
# 4. Plot overall frequency map
# =============================
fig = plt.figure(figsize=(10, 6))
ax = plt.axes(projection=ccrs.PlateCarree())
lon_vals = overall_grid.columns.values
lat_vals = overall_grid.index.values
pcm = ax.pcolormesh(
    lon_vals,
    lat_vals,
    overall_grid.values,
    cmap="hot_r",
    shading="auto",
    transform=ccrs.PlateCarree()
)
ax.coastlines(linewidth=0.8)
ax.add_feature(cfeature.LAND, facecolor="lightgray")
gl = ax.gridlines(
    draw_labels=True,
    linewidth=0.5,
    alpha=0.5
)
gl.top_labels = False
gl.right_labels = False
cbar = plt.colorbar(
    pcm,
    ax=ax,
    orientation="horizontal",
    pad=0.08,
    fraction=0.05
)
cbar.set_label("Number of MHW Events")
plt.title("Overall MHW Frequency Map (1981–2024)")
plt.tight_layout()
plt.show()
# =============================
# 5. Seasonal frequency grids
# =============================
season_order = ["DJF", "MAM", "JJA", "SON"]
seasonal_grids = {}
for season in season_order:
    season_df = df[df["season"] == season]
    season_freq = (
        season_df
        .groupby(["lat", "lon_plot"])
        .size()
        .reset_index(name="frequency")
    )
    season_grid = season_freq.pivot(
        index="lat",
        columns="lon_plot",
        values="frequency"
    )
    seasonal_grids[season] = season_grid
# =============================
# 6. Shared seasonal color scale
# =============================
vmax = max(
    grid.max().max()
    for grid in seasonal_grids.values()
)
# =============================
# 7. Plot seasonal maps
# =============================
fig, axes = plt.subplots(
    2,
    2,
    figsize=(12, 8),
    subplot_kw={"projection": ccrs.PlateCarree()}
)
axes = axes.flatten()
for ax, season in zip(axes, season_order):
    grid = seasonal_grids[season]
    lon_vals = grid.columns.values
    lat_vals = grid.index.values
    pcm = ax.pcolormesh(
        lon_vals,
        lat_vals,
        grid.values,
        cmap="hot_r",
        shading="auto",
        vmin=0,
        vmax=vmax,
        transform=ccrs.PlateCarree()
    )
    ax.coastlines(linewidth=0.8)
    ax.add_feature(cfeature.LAND, facecolor="lightgray")
    gl = ax.gridlines(
        draw_labels=True,
        linewidth=0.5,
        alpha=0.5
    )
    gl.top_labels = False
    gl.right_labels = False
    ax.set_title(season, fontsize=14)
# =============================
# 8. Adjust seasonal layout
# =============================
plt.subplots_adjust(
    left=0.06,
    right=0.94,
    top=0.90,
    bottom=0.16,
    wspace=0.03,
    hspace=0.25
)
# =============================
# 9. Seasonal colorbar
# =============================
cbar = fig.colorbar(
    pcm,
    ax=axes,
    orientation="horizontal",
    fraction=0.04,
    pad=0.10,
    shrink=0.75
)
cbar.set_label("Number of MHW Events", fontsize=12)
plt.suptitle(
    "Seasonal MHW Frequency Maps (1981–2024)",
    fontsize=16,
    y=0.96
)
plt.show()


