import xarray as xr
import numpy as np
import matplotlib.pyplot as plt
import cartopy.crs as ccrs
import cartopy.feature as cfeature

# =============================
# 1. Settings
# =============================

year = 2000

sst_folder = r"C:/Users/Aina Ajibola/Desktop/oisst_data"
p90_file = r"C:/Users/Aina Ajibola/Desktop/P90_1981-2010/threshold.nc"

# =============================
# 2. Load SST and P90
# =============================

print("Loading SST files...")

sst_ds = xr.open_mfdataset(
    f"{sst_folder}/{year}*.nc",
    combine="by_coords"
)

p90_ds = xr.open_dataset(p90_file)

print("Files loaded.")

# =============================
# 3. Extract variables and remove zlev
# =============================

sst = sst_ds["sst"].isel(zlev=0, drop=True)
p90 = p90_ds["p90_threshold"].isel(zlev=0, drop=True)

# =============================
# 4. Match SST region to P90 grid
# =============================

sst = sst.sel(
    lat=slice(0, 30),
    lon=slice(300, 350)
)

sst = sst.sel(
    lat=p90.lat,
    lon=p90.lon
)

sst = sst.transpose("time", "lat", "lon")
p90 = p90.transpose("dayofyear", "lat", "lon")

print("SST shape:", sst.shape)
print("P90 shape:", p90.shape)

# =============================
# 5. Match daily P90 to SST dates
# =============================

sst = sst.assign_coords(
    dayofyear=sst["time"].dt.dayofyear
)

p90_for_year = p90.sel(
    dayofyear=sst["dayofyear"]
)

p90_for_year = p90_for_year.assign_coords(
    time=sst["time"]
)

p90_for_year = p90_for_year.transpose("time", "lat", "lon")

# =============================
# 6. Daily exceedance
# =============================

above_p90 = (sst > p90_for_year).compute()

# =============================
# 7. Detect MHW days >= 5 consecutive days
# =============================

def detect_mhw_1d(arr):
    arr = np.asarray(arr)
    arr = np.nan_to_num(arr, nan=False).astype(bool)

    result = np.zeros_like(arr, dtype=bool)

    n = len(arr)
    i = 0

    while i < n:
        if arr[i]:
            start = i

            while i < n and arr[i]:
                i += 1

            end = i

            if end - start >= 5:
                result[start:end] = True
        else:
            i += 1

    return result


print("Detecting MHW events...")

mhw_days = xr.apply_ufunc(
    detect_mhw_1d,
    above_p90,
    input_core_dims=[["time"]],
    output_core_dims=[["time"]],
    vectorize=True,
    output_dtypes=[bool]
)

mhw_days = mhw_days.transpose("time", "lat", "lon")

print("MHW detection completed.")

# =============================
# 8. Monthly MHW days
# =============================

monthly_mhw_days = mhw_days.groupby("time.month").sum(dim="time")

# =============================
# 9. Plot Monthly MHW Days
# =============================

fig, axes = plt.subplots(
    3, 4,
    figsize=(16, 10),
    subplot_kw={"projection": ccrs.PlateCarree()}
)

axes = axes.flatten()

month_names = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
]

for i in range(12):
    month = i + 1
    ax = axes[i]

    plot_data = monthly_mhw_days.sel(month=month)

    pcm = plot_data.plot(
        ax=ax,
        transform=ccrs.PlateCarree(),
        cmap="hot_r",
        add_colorbar=False,
        vmin=0,
        vmax=31
    )

    ax.coastlines()
    ax.add_feature(cfeature.LAND, facecolor="lightgray")

    gl = ax.gridlines(draw_labels=True)
    gl.top_labels = False
    gl.right_labels = False

    ax.set_title(f"{month_names[i]} {year}")

# =============================
# 10. Colorbar and layout
# =============================

cbar = fig.colorbar(
    pcm,
    ax=axes,
    orientation="horizontal",
    fraction=0.04,
    pad=0.15
)

cbar.set_label("Monthly MHW Days")

plt.subplots_adjust(
    bottom=0.22,
    top=0.92,
    left=0.05,
    right=0.95,
    wspace=0.15,
    hspace=0.25
)

plt.suptitle(
    f"Monthly Marine Heatwave Days Based on Daily SST > Daily P90 ({year})",
    y=0.98
)

plt.show()
