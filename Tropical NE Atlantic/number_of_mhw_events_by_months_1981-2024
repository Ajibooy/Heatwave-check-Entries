import pandas as pd
import matplotlib.pyplot as plt
# =============================
# Load CSV
# =============================
df = pd.read_csv(
    r"C:/Users/Aina Ajibola/Desktop/mhw_events_1981_2024.csv"
)
# =============================
# Count events by month
# =============================
monthly_counts = (
    df["month"]
    .value_counts()
    .sort_index()
)
# =============================
# Month labels
# =============================
month_labels = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
]
# Ensure all 12 months exist
monthly_counts = monthly_counts.reindex(
    range(1, 13),
    fill_value=0
)
# =============================
# Plot
# =============================
plt.figure(figsize=(10, 5))
plt.bar(
    month_labels,
    monthly_counts.values
)
plt.title(
    "Number of Marine Heatwave Events by Month (1981–2024)"
)
plt.xlabel("Month")
plt.ylabel("Number of MHW Events")
plt.grid(
    axis="y",
    linestyle="--",
    alpha=0.4
)
plt.tight_layout()
plt.show()
# =============================
# Print counts
# =============================
print(monthly_counts)

