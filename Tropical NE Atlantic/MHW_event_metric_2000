import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
# =============================
# 1. Load CSV
# =============================
csv_file = r"C:/Users/Aina Ajibola/Desktop/mhw_events_1981_2024.csv"
df = pd.read_csv(csv_file)
# =============================
# 2. Optional filter
# =============================
# Use one year first so the plot is readable.
# Remove this line if you want all years, but all years will be too crowded.
df = df[df["start_year"] == 2000].copy()
# =============================
# 3. Sort events
# =============================
df = df.sort_values("start_date").reset_index(drop=True)
# Optional: limit number of events plotted
# This keeps the figure readable.
max_events_to_plot = 80
df_plot = df.head(max_events_to_plot).copy()
df_plot["event_number"] = np.arange(1, len(df_plot) + 1)
# =============================
# 4. Columns to plot
# =============================
metrics = {
    "Duration": {
        "column": "duration_days",
        "ylabel": "Days"
    },
    "Maximum Intensity": {
        "column": "max_intensity",
        "ylabel": "°C"
    },
    "Cumulative Intensity": {
        "column": "cumulative_intensity",
        "ylabel": "°C days"
    },
    "Mean Intensity": {
        "column": "mean_intensity",
        "ylabel": "°C"
    }
}
# =============================
# 5. Plot
# =============================
fig, axes = plt.subplots(2, 2, figsize=(14, 8))
axes = axes.flatten()
for ax, (title, info) in zip(axes, metrics.items()):
    col = info["column"]
    values = df_plot[col].values
    x = df_plot["event_number"].values
    # largest event for this metric
    max_idx = values.argmax()
    colors = ["lightgray"] * len(values)
    edgecolors = ["black"] * len(values)
    linewidths = [0.8] * len(values)
    # red shaded bar = largest event for that metric
    colors[max_idx] = "red"
    edgecolors[max_idx] = "red"
    ax.bar(
        x,
        values,
        color=colors,
        edgecolor=edgecolors,
        linewidth=linewidths
    )
    ax.set_title(title)
    ax.set_xlabel("MHW event number")
    ax.set_ylabel(info["ylabel"])
    ax.grid(axis="y", alpha=0.3)
plt.suptitle("MHW Event Metrics for Year 2000", fontsize=14)
plt.tight_layout()
plt.show()
